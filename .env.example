# Configuracion de la Porra del Mundial 2026 (opcional: hay valores por defecto).
# Copia este fichero a ".env" para desarrollo local. NUNCA subas tu ".env" al repo.

# --- Local (desarrollo) ---------------------------------------------------

# Ruta del fichero de base de datos SQLite.
DB_PATH=porra.db

# Secreto para firmar las sesiones (cookies). Cambialo por una cadena larga y aleatoria.
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cuenta de administrador que se crea automaticamente al arrancar (si no existe).
ADMIN_NAME=admin
ADMIN_PASSWORD=admin1234

# Host y puerto del servidor.
HOST=127.0.0.1
PORT=8000

# --- Despliegue en la nube (Render + Turso) -------------------------------
# En produccion NO uses este fichero: define estas variables en el panel de
# Render. Si TURSO_DATABASE_URL esta definida, la app usa Turso (libSQL) en
# lugar del SQLite local, y los datos persisten entre reinicios.
#
# TURSO_DATABASE_URL=libsql://tu-base-de-datos-tu-org.turso.io
# TURSO_AUTH_TOKEN=el-token-que-te-da-turso
#
# En Render, ademas: deja HOST sin definir (se usa 0.0.0.0) y NO definas PORT
# (Render lo inyecta automaticamente). Pon AUTH_SECRET largo/aleatorio y unas
# credenciales de admin propias.
